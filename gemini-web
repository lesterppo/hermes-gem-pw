#!/usr/bin/env python3
"""
gemini-web — AI-agent-native CLI for ALL Gemini Web functions.
Drives gemini.google.com via Windows Chrome CDP (Playwright).

Token-efficient: pointer JSON on stdout, full response on disk.
Zero API keys. Browser auth via persistent Chrome profile.

Functions:
  chat       Direct chat (Flash/Pro/Lite, extended thinking)
  multi      Multi-turn conversation with context
  img        Image generation via Imagen
  upload     Upload files for analysis
  research   Deep research mode
  history    List/read/delete chat history
  account    Account + model info
  gems       List/open Gems

Usage:
  gemini-web chat "prompt" [-m flash|pro|lite] [--thinking extended] [-o out.md]
  gemini-web multi [-c sess.json] "turn1" "turn2" ...
  gemini-web img "a cat wearing a hat" [-o cat.png]
  gemini-web upload -f report.pdf "summarize this"
  gemini-web research "complex multi-step question"
  gemini-web history [--list|--read ID|--delete ID]
  gemini-web account
  gemini-web gems [--list|--open ID "prompt"]

Output (stdout):
  {"ok":true,"f":"/path/to/response.md","s":1234,"t":4.5}
  {"ok":false,"err":"TIMEOUT","msg":"..."}
"""

import asyncio, argparse, json, os, re, sys, time
from datetime import datetime, timezone
from pathlib import Path
from playwright.async_api import async_playwright, TimeoutError as PwTimeout

# ═══════════════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════════════

_DEFAULT_CDP = "http://127.0.0.1:9224"
CDP_URL = os.environ.get("GEMINI_CDP", os.environ.get("GEM_PW_CDP", _DEFAULT_CDP))
OUTPUT_DIR = Path(os.environ.get("GEMINI_OUTPUT", os.path.expanduser("~/.hermes/gem_pw_output")))
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
APP_URL = "https://gemini.google.com/app"
GEM_CREATE_URL = "https://gemini.google.com/gems/create"

# Model mappings (locale-agnostic: zh-TW + English)
MODEL_MAP = {
    "flash":      {"label": "Flash",      "menuitem": "Flash",      "alt": "3.6 Flash"},
    "pro":        {"label": "3.1 Pro",    "menuitem": "3.1 Pro",    "alt": "Pro"},
    "lite":       {"label": "3.5 Flash-Lite", "menuitem": "3.5 Flash-Lite", "alt": "Flash-Lite"},
    "flash-lite": {"label": "3.5 Flash-Lite", "menuitem": "3.5 Flash-Lite", "alt": "Flash-Lite"},
}

THINKING_MAP = {
    "extended": "延伸思考",
    "standard": "標準思考",
}

SELECTORS = {
    "chat_input": 'div[role="textbox"]',
    "model_picker": 'button[aria-label*="模式挑選器"], button[aria-label*="mode picker"], button[aria-label*="Open mode picker"]',
    "menuitem": '[role="menuitem"]',
    "sidebar_toggle": 'button[aria-label*="主選單"], button[aria-label*="選單"], button[aria-label*="menu"], button[aria-label*="navigation"]',
    "new_chat": 'button[aria-label*="新對話"], button[aria-label*="new chat"], a[href="/app"]',
    "plus_menu": 'button[aria-label*="Upload"], button[aria-label*="上載"], button[aria-label*="tools"]',
    "file_input": 'input[type="file"]',
    "deep_research": 'button:has-text("Deep research"), button:has-text("深度研究")',
    "chat_list": 'a[href*="/app/"]',
    "chat_item": '[class*="conversation"], [class*="chat-item"], [class*="history-item"]',
    "dismiss_btn": 'button:has-text("我知道了"), button:has-text("Got it"), button:has-text("OK")',
}

LONG_TIMEOUT = 120  # for deep research
DEFAULT_TIMEOUT = 60
FAST_TIMEOUT = 30

# ═══════════════════════════════════════════════════════════════
# Output helpers (token-efficient)
# ═══════════════════════════════════════════════════════════════

def _ok(**kw):
    return json.dumps({"ok": True, **kw})

def _err(code, msg, **kw):
    return json.dumps({"ok": False, "err": code, "msg": msg, **kw})

def _emit(data):
    print(data, flush=True)

def _save(text, prefix="gemini-web"):
    ts = int(time.time())
    path = OUTPUT_DIR / f"{prefix}-{ts}.md"
    path.write_text(text, encoding="utf-8")
    return str(path)

def _log(msg):
    print(f"[gemini-web] {msg}", file=sys.stderr, flush=True)

# ═══════════════════════════════════════════════════════════════
# Browser helpers
# ═══════════════════════════════════════════════════════════════

async def _dismiss_dialogs(page):
    """Dismiss 'Got it' / '我知道了' dialogs."""
    for _ in range(3):
        try:
            btn = await page.query_selector(SELECTORS["dismiss_btn"])
            if btn and await btn.is_visible():
                await btn.click(timeout=3000)
                await page.wait_for_timeout(800)
        except Exception:
            break

async def _ensure_app(page):
    """Navigate to app if not already there."""
    if "/app" not in page.url:
        await page.goto(APP_URL, timeout=15000, wait_until="domcontentloaded")
        await page.wait_for_timeout(3000)
        await _dismiss_dialogs(page)

async def _find_input(page):
    """Find and return the chat input element."""
    await _ensure_app(page)
    inp = await page.wait_for_selector(SELECTORS["chat_input"], timeout=10000)
    return inp

async def _select_model(page, model_str):
    """Switch model in the Gemini UI."""
    if not model_str or model_str == "flash":
        return  # default

    cfg = MODEL_MAP.get(model_str)
    if not cfg:
        _log(f"unknown model: {model_str}")
        return

    try:
        # Open model picker
        btn = await page.query_selector(SELECTORS["model_picker"])
        if not btn:
            return
        await btn.click()
        await page.wait_for_timeout(1200)

        # Find matching menuitem
        found = False
        items = await page.query_selector_all(SELECTORS["menuitem"])
        for item in items:
            text = (await item.inner_text()).strip()
            if cfg["menuitem"] in text or cfg["alt"] in text:
                await item.click()
                found = True
                await page.wait_for_timeout(1500)
                break

        if not found:
            _log(f"model '{model_str}' not found in picker")
    except Exception as e:
        _log(f"model select failed: {e}")

async def _select_thinking(page, thinking):
    """Toggle extended thinking (separate menu open)."""
    if not thinking or thinking == "standard":
        return

    try:
        # Open model picker again (menu closes after each selection)
        btn = await page.query_selector(SELECTORS["model_picker"])
        if not btn:
            return
        await btn.click()
        await page.wait_for_timeout(1200)

        # Find thinking menuitem
        items = await page.query_selector_all(SELECTORS["menuitem"])
        for item in items:
            text = (await item.inner_text()).strip()
            if "延伸思考" in text or "Extended thinking" in text or "extended" in text.lower():
                await item.click()
                await page.wait_for_timeout(1500)
                break
    except Exception as e:
        _log(f"thinking select failed: {e}")

async def _click_plus_menu(page):
    """Open the '+' / upload menu."""
    try:
        # The plus/tools button near the chat input
        btns = await page.query_selector_all('button')
        for btn in btns:
            try:
                aria = await btn.get_attribute("aria-label") or ""
                if "upload" in aria.lower() or "上載" in aria or "tools" in aria.lower():
                    await btn.click()
                    await page.wait_for_timeout(1000)
                    return True
            except:
                pass
        # Fallback: look for the paperclip/plus icon
        plus = await page.query_selector('button mat-icon, button [class*="upload"], button [class*="plus"]')
        if plus:
            await plus.click()
            await page.wait_for_timeout(1000)
            return True
    except:
        pass
    return False

async def _extract_response(page, prompt, wait_s=6):
    """Wait for and extract Gemini's response from page body."""
    await page.wait_for_timeout(int(wait_s * 1000))
    body = await page.evaluate("document.body.innerText")

    # Find the LAST occurrence of the prompt (for multi-turn)
    search = prompt[:30]
    # Find all occurrences, take last
    positions = [m.start() for m in re.finditer(re.escape(search[:15]), body)]
    idx = positions[-1] if positions else -1

    if idx >= 0:
        after = body[idx:]

        # Find the LAST "Gemini 說了" / "Gemini said" after the prompt
        said_match = None
        for m in re.finditer(r'(Gemini (?:說了|said)|模型 (?:說了|said))', after):
            said_match = m

        if said_match:
            # Take everything after "說了" marker
            response_start = said_match.end()
            response_text = after[response_start:]

            # Strip leading whitespace/newlines
            response_text = response_text.strip()

            # Cut at model footer markers
            for cutoff in ['\n\n\n\nFlash', '\n\n\n\nPro', '\n\n\n\nLite',
                          '\n\nFlash\n', '\n\nPro\n', '\n\nLite\n',
                          '\nGemini 是 AI', '\nGemini may display',
                          '\n你說了\n', '\nYou said\n',
                          '\n適用《Google', '\nGemini 是',
                          '\nGemini 可能會']:
                cut_idx = response_text.find(cutoff)
                if cut_idx > 0:
                    response_text = response_text[:cut_idx]

            return response_text.strip()

    return body[:500]

async def _send_and_wait(page, prompt, wait_s=8):
    """Type prompt, press Enter, wait for response."""
    inp = await _find_input(page)
    await inp.click()
    await page.keyboard.press("Control+a")
    await page.keyboard.type(prompt)
    await page.keyboard.press("Enter")

    t0 = time.time()
    text = await _extract_response(page, prompt, wait_s)
    elapsed = time.time() - t0
    return text, elapsed

