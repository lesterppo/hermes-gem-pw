async def cmd_history(args):
    """Chat history management."""
    async with async_playwright() as pw:
        browser = await pw.chromium.connect_over_cdp(args.cdp or CDP_URL)
        page = await browser.new_page()
        await page.goto(APP_URL, timeout=15000)
        await page.wait_for_timeout(3000)

        if args.read_chat or args.delete_chat:
            cid = args.read_chat or args.delete_chat
            # Navigate to specific chat
            await page.goto(f"https://gemini.google.com/app/{cid}", timeout=15000)
            await page.wait_for_timeout(3000)

            if args.read_chat:
                body = await page.evaluate("document.body.innerText")
                _emit(_ok(chat_id=cid, content=body[:5000]))
            elif args.delete_chat:
                # Find and click delete button
                try:
                    menu = await page.query_selector('button[aria-label*="更多"], button[aria-label*="more"]')
                    if menu:
                        await menu.click()
                        await page.wait_for_timeout(500)
                        delete_btn = await page.query_selector('[role="menuitem"]:has-text("Delete"), [role="menuitem"]:has-text("刪除")')
                        if delete_btn:
                            await delete_btn.click()
                            _emit(_ok(action="deleted", chat_id=cid))
                        else:
                            _emit(_err("NO_DELETE", "Delete button not found"))
                    else:
                        _emit(_err("NO_MENU", "Menu button not found"))
                except Exception as e:
                    _emit(_err("DELETE_FAILED", str(e)))
        else:
            # List chats
            chats = await page.evaluate("""() => {
                const result = [];
                document.querySelectorAll('a[href*="/app/"]').forEach(a => {
                    const href = a.getAttribute('href');
                    const m = href.match(/\\/app\\/([a-f0-9]+)/);
                    if (m) {
                        result.push({id: m[1], title: (a.innerText || '').substring(0, 100)});
                    }
                });
                return result;
            }""")

            _emit(_ok(chats=chats, count=len(chats)))

        await browser.close()


async def cmd_account(args):
    """Account information."""
    async with async_playwright() as pw:
        browser = await pw.chromium.connect_over_cdp(args.cdp or CDP_URL)
        page = await browser.new_page()
        await page.goto(APP_URL, timeout=15000)
        await page.wait_for_timeout(3000)

        # Extract account info from page
        info = await page.evaluate("""() => {
            const body = document.body.innerText;
            // Find model info
            const models = [];
            const pickerBtn = document.querySelector('button[aria-label*="mode picker"], button[aria-label*="模式挑選器"]');
            const currentModel = pickerBtn ? pickerBtn.getAttribute('aria-label') || pickerBtn.innerText : 'unknown';

            // Check for account email
            const emailMatch = body.match(/[\\w.+-]+@gmail\\.com/);
            const email = emailMatch ? emailMatch[0] : null;

            return {
                current_model: currentModel.substring(0, 100),
                signed_in: !!email,
                email: email,
                has_chat_input: !!document.querySelector('div[role="textbox"]'),
            };
        }""")

        _emit(_ok(**info))
        await browser.close()


