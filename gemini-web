def main():
    parser = argparse.ArgumentParser(
        description="gemini-web — AI-agent-native CLI for ALL Gemini Web functions")
    sub = parser.add_subparsers(dest="command")

    # ── chat ──
    p = sub.add_parser("chat", help="Direct chat (single turn)")
    p.add_argument("prompt", nargs="+", help="Prompt text")
    p.add_argument("-m", "--model", choices=["flash", "pro", "lite", "flash-lite"],
                   default="flash", help="Model (default: flash)")
    p.add_argument("--thinking", choices=["standard", "extended"], help="Thinking tier")
    p.add_argument("-o", "--output", help="Output file path")
    p.add_argument("--json-out", action="store_true", help="JSON output")
    p.add_argument("--brief", action="store_true", help="Prepend 'Be concise.'")
