async def cmd_chat(args):
    """Direct chat (single turn)."""
    async with async_playwright() as pw:
        browser = await pw.chromium.connect_over_cdp(args.cdp or CDP_URL)
        page = await browser.new_page()

        await _select_model(page, args.model)
        await _select_thinking(page, args.thinking)

        prompt = " ".join(args.prompt) if isinstance(args.prompt, list) else args.prompt
        if args.brief:
            prompt = "Be concise. " + prompt

        text, elapsed = await _send_and_wait(page, prompt, args.wait)

        if not text:
            _emit(_err("EMPTY", "No response extracted"))
        elif args.json_out or args.output:
            path = args.output or _save(text)
            _emit(_ok(f=path, s=len(text), t=round(elapsed, 1), model=args.model))
        else:
            print(text)

        await browser.close()


async def cmd_multi(args):
    """Multi-turn conversation."""
    prompts = args.prompts

    async with async_playwright() as pw:
        browser = await pw.chromium.connect_over_cdp(args.cdp or CDP_URL)
        page = await browser.new_page()

        await _select_model(page, args.model)
        await _select_thinking(page, args.thinking)

        # Resume session if provided
        if args.conversation and Path(args.conversation).exists():
            conv_url = Path(args.conversation).read_text().strip()
            if "/app/" in conv_url:
                await page.goto(conv_url, timeout=15000)
                await page.wait_for_timeout(3000)

        results = []
        for i, prompt in enumerate(prompts):
            if args.brief and i == 0:
                prompt = "Be concise. " + prompt

            _log(f"Turn {i+1}/{len(prompts)}")
            text, elapsed = await _send_and_wait(page, prompt, args.wait)
            results.append({"turn": i+1, "prompt": prompt, "response": text, "time": elapsed})

            # Save conversation URL for resumption
            if args.conversation and "/app/" in page.url:
                Path(args.conversation).write_text(page.url)

        # Output
        all_text = "\n\n---\n\n".join(
            f"## Turn {r['turn']} ({r['time']:.1f}s)\n\n**Q:** {r['prompt']}\n\n**A:** {r['response']}"
            for r in results
        )

        if args.json_out or args.output:
            path = args.output or _save(all_text, "gemini-multi")
            _emit(_ok(f=path, s=len(all_text), turns=len(results)))
        else:
            print(all_text)

        await browser.close()


async def cmd_img(args):
    """Image generation via Imagen — uses Upload & tools → Create image drawer."""
    prompt = " ".join(args.prompt) if isinstance(args.prompt, list) else args.prompt

    async with async_playwright() as pw:
        browser = await pw.chromium.connect_over_cdp(args.cdp or CDP_URL)
        page = await browser.new_page()
        await page.goto(f"{APP_URL}", wait_until="domcontentloaded", timeout=30000)
        await page.wait_for_timeout(4000)

        # Image gen works with Flash model
        await _select_model(page, "flash")
        await _dismiss_dialogs(page)

        # Click "Upload & tools" button to open the drawer
        tools = await page.query_selector('button[aria-label="Upload & tools"]')
        if not tools:
            tools = await page.query_selector('[aria-label*="Upload"][aria-label*="tool"]')
        if tools:
            await tools.click()
            await page.wait_for_timeout(2000)

        # Click "Create image" in the toolbox drawer
        clicked = await page.evaluate("""() => {
            const items = document.querySelectorAll('toolbox-drawer-item');
            for (const item of items) {
                if ((item.innerText||'').trim().startsWith('Create image')) {
                    item.click(); return 'ok';
                }
            }
            return 'not-found';
        }""")
        if clicked != 'ok':
            _log("Create image not found in drawer, falling back to text prompt")
        await page.wait_for_timeout(3000)

        _log(f"Generating image: {prompt}")
        text, elapsed = await _send_and_wait(page, prompt, max(args.wait, 60))

        # Wait for image rendering (Imagen can take extra time)
        images = []
        for _ in range(15):
            await page.wait_for_timeout(3000)
            images = await page.evaluate("""() => {
                const imgs = document.querySelectorAll('img[src*="googleapis"], img[src*="generated"], .response-content img');
                return Array.from(imgs).map(i => ({src: i.src, alt: i.alt || ''}));
            }""")
            if images:
                break

        if args.json_out or args.output:
            result = json.dumps({"response": text[:500] if text else "", "images": images, "time": elapsed})
            path = args.output or _save(result, "gemini-img")
            _emit(_ok(f=path, s=len(text or ""), img=len(images), t=round(elapsed, 1)))
        else:
            print(text or "[no text response]")
            for img in images:
                print(f"IMAGE: {img['src']}")

        await browser.close()


async def cmd_upload(args):
    """Upload file(s) and optionally ask a question."""
    if not args.file:
        _emit(_err("NO_FILE", "Use -f/--file to specify file(s) to upload"))
        return

    question = " ".join(args.prompt) if args.prompt else "Summarize this."

    async with async_playwright() as pw:
        browser = await pw.chromium.connect_over_cdp(args.cdp or CDP_URL)
        page = await browser.new_page()
        await page.goto(APP_URL, timeout=15000, wait_until="domcontentloaded")
        await page.wait_for_timeout(3000)
        await _dismiss_dialogs(page)

        # Upload flow:
        # 1. Click "上傳與工具" button  
        # 2. Dismiss any dialog that appears
        # 3. Click upload button via force click
        # 4. File input appears — set files
        uploaded = False
        try:
            # Step 1: Open upload menu
            menu_btn = await page.query_selector('button[aria-label="上傳與工具"]')
            _log(f"Menu btn: {'found' if menu_btn else 'MISSING'}")
            if menu_btn:
                await menu_btn.click()
                await page.wait_for_timeout(1200)
                await _dismiss_dialogs(page)

                # Step 2: Find and click upload button (force click to bypass disabled)
                upload_btn = await page.query_selector('button[aria-label*="上傳檔案"]')
                _log(f"Upload btn: {'found' if upload_btn else 'MISSING'}")
                if upload_btn:
                    # Force click — bypasses disabled state
                    await upload_btn.dispatch_event("click")
                    await page.wait_for_timeout(2000)
                else:
                    # Try clicking the menuitem role
                    upload_opt = await page.query_selector('[role="menuitem"]:has-text("上傳檔案")')
                    if upload_opt:
                        await upload_opt.dispatch_event("click")
                        await page.wait_for_timeout(2000)

            # Step 3: File input
            file_input = await page.query_selector('input[type="file"]')
            _log(f"File input: {'found' if file_input else 'MISSING'}")
            if file_input:
                await file_input.set_input_files(args.file)
                uploaded = True
                _log(f"Uploaded {len(args.file)} file(s)")
                await page.wait_for_timeout(2000)
        except Exception as e:
            _log(f"Upload error: {e}")

        # Send question
        text, elapsed = await _send_and_wait(page, question, args.wait)

        if args.json_out or args.output:
            path = args.output or _save(text or "", "gemini-upload")
            _emit(_ok(f=path, s=len(text or ""), uploaded=uploaded, t=round(elapsed, 1)))
        else:
            print(text or "[no response]")

        await browser.close()


